{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "thepermitcloser.com" }],
      "destination": "/permit-closer"
    },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "www.thepermitcloser.com" }],
      "destination": "/permit-closer"
    }
  ]
}
