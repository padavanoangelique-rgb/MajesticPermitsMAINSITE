{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "thepermitcloser.com" }],
      "destination": "https://majesticpermits.com/permit-closer",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.thepermitcloser.com" }],
      "destination": "https://majesticpermits.com/permit-closer",
      "permanent": true
    }
  ]
}
